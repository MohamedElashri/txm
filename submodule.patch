-		ri.ptr,
-		C.GHOSTTY_RENDER_STATE_ROW_DATA_CELLS_RAW,
-		unsafe.Pointer(&view),
-	)); err != nil {
-		return CellsView{}, err
-	}
-	return cellsViewFromC(view), nil
-}
