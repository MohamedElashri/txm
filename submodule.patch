-	if err != nil {
-		t.Fatal(err)
-	}
-	if cols != 80 {
-		t.Fatalf("expected 80 cols, got %d", cols)
-	}
-
-	rows, err := term.Rows()
-	if err != nil {
-		t.Fatal(err)
-	}
-	if rows != 24 {
-		t.Fatalf("expected 24 rows, got %d", rows)
-	}
-
-	// Resize and verify.
-	if err := term.Resize(120, 40, 8, 16); err != nil {
-		t.Fatal(err)
-	}
-	cols, _ = term.Cols()
-	rows, _ = term.Rows()
-	if cols != 120 || rows != 40 {
-		t.Fatalf("expected 120x40 after resize, got %dx%d", cols, rows)
-	}
-}
