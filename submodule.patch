-func TestTerminalCursorPosition(t *testing.T) {
-	term, err := NewTerminal(WithSize(80, 24))
-	if err != nil {
-		t.Fatal(err)
-	}
-	defer term.Close()
-
-	// Cursor starts at 0,0.
-	x, err := term.CursorX()
-	if err != nil {
-		t.Fatal(err)
-	}
-	y, err := term.CursorY()
-	if err != nil {
-		t.Fatal(err)
-	}
-	if x != 0 || y != 0 {
-		t.Fatalf("expected cursor at 0,0, got %d,%d", x, y)
-	}
