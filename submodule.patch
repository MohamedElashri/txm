-	cVals, cValsSize := cValuesArray(values)
-	defer Free(unsafe.Pointer(cVals), cValsSize)
-	return resultError(C.ghostty_render_state_row_get_multi(
-		ri.ptr,
-		C.size_t(len(keys)),
-		(*C.GhosttyRenderStateRowData)(unsafe.Pointer(&keys[0])),
-		cVals,
-		nil,
-	))
