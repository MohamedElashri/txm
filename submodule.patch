-	// Move cursor to col 5, row 3 (1-indexed in VT: CSI 4;6H).
-	term.VTWrite([]byte("\x1b[4;6H"))
-	x, _ = term.CursorX()
-	y, _ = term.CursorY()
-	if x != 5 || y != 3 {
-		t.Fatalf("expected cursor at 5,3, got %d,%d", x, y)
-	}
-}
