-	// Kitty's special "." MIME asks for the available-target listing. This
-	// exercises the separate Available array in ClipboardReadReply.
-	output = output[:0]
-	term.VTWrite([]byte("\x1b]5522;type=read:id=list:name=YXBw;Lg==\x1b\\"))
